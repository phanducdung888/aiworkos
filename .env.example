# Copy to .env and adjust. .env is git-ignored; never commit real credentials.

# --- PostgreSQL bootstrap superuser ---
# Creates the cluster and runs ops/db/dev-roles.sql at initdb. Nothing else ever connects as it:
# FORCE ROW LEVEL SECURITY is not enforced against a superuser, so a superuser connection silently
# disables one of the two tenancy controls (see docs/security/security-model.md §3.4).
POSTGRES_USER=workos
POSTGRES_PASSWORD=workos
POSTGRES_DB=workos

# --- Owner role: owns the schema, runs migrations ---
# NOSUPERUSER and NOBYPASSRLS, so tenant policies apply to it like anyone else.
OWNER_DB_PASSWORD=workos_owner

# --- Application role: what the API actually connects as ---
# Owns nothing. Combined with FORCE ROW LEVEL SECURITY this gives two independent tenancy controls
# rather than one.
APP_DB_PASSWORD=workos_app

# --- Connection strings used by the backend and by pytest ---
# Local (running Python on the host against Compose's PostgreSQL):
WORKOS_DATABASE_URL=postgresql+psycopg://workos_owner:workos_owner@127.0.0.1:5432/workos
WORKOS_APP_DATABASE_URL=postgresql+psycopg://workos_app:workos_app@127.0.0.1:5432/workos

# Tests use a separate database so a failed run never touches development data.
# See Makefile target `test-db`.

# --- Object storage (Phase 2) ---
MINIO_ROOT_USER=workos
MINIO_ROOT_PASSWORD=workos-dev-secret

# --- Keycloak (Checkpoint 4) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- The model provider (ADR-0049) ---
# `fake` unless you say otherwise, so the real adapter is never on a default path. No key here and
# no default for one: it is passed through from your environment or it is absent.
WORKOS_LLM_PROVIDER=fake
OPENAI_API_KEY=

# --- The mailbox the connector reads (CP25) ---
# Gmail needs an *app password*, not the account password: turn on 2-Step Verification, then
# myaccount.google.com/apppasswords. Enter the 16 characters with the spaces removed, in quotes —
# unquoted, the spaces make this line unreadable to anything that sources the file as a shell
# script, and the failure is confusing rather than loud.
#
# `IMAP_MAILBOX` must not contain a space: `imaplib` sends command arguments verbatim without
# quoting, so `Work OS` is a protocol error and `[Gmail]/All Mail` cannot be selected at all.
# Point this at a dedicated label with a filter routing mail into it, never at INBOX — the
# connector marks what it delivers as read, and every message it reads becomes an Event.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURITY=ssl
IMAP_USERNAME=
IMAP_PASSWORD=""
IMAP_MAILBOX=WorkOS
IMAP_INTERVAL=60

# --- What the connector authenticates as (ADR-0066) ---
# The client secret is the credential and has no default anywhere: the connector obtains its own
# access token with it and renews it, which is what lets it run unattended. Leaving it empty falls
# back to WORKOS_INGESTION_TOKEN, which expires and cannot be renewed.
WORKOS_CLIENT_ID=workos-connector
WORKOS_CLIENT_SECRET=
WORKOS_ORGANIZATION_ID=

# --- Where attachments are reached from (ADR-0067) ---
# Two different clients on two different networks, and a presigned URL cannot be rewritten after
# signing. The browser's address must be one a laptop resolves; the connector's is the proxy's
# service name. Defaults in docker-compose.yml suit the local stack.
# WORKOS_S3_PUBLIC_ENDPOINT_URL=http://localhost:9002
# WORKOS_S3_UPLOAD_ENDPOINT_URL=http://objects:9000
