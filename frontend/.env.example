# Copy to .env.local. Nothing here is a secret: a public OIDC client has no secret by design,
# and the API is reached through the dev proxy on the same origin.
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/workos
VITE_OIDC_CLIENT_ID=workos-web
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
