[importlinter]
root_package = app
include_external_packages = True

# ---------------------------------------------------------------------------
# ADR-0001: a modular monolith is only modular if the boundaries are enforced.
# ---------------------------------------------------------------------------

[importlinter:contract:layers]
name = Layered architecture
type = layers
layers =
    app.api
    app.contexts
    app.platform

[importlinter:contract:context-isolation]
name = Bounded contexts do not reach into each other
type = independence
modules =
    app.contexts.identity
    app.contexts.signal
    app.contexts.work
    app.contexts.commitment
    app.contexts.intelligence
# ADR-0001 forbids reaching into another context, not talking to one. A context's `public` module
# is the published interface and is the one edge that is allowed; everything behind it stays
# unreachable. Listing the exception here rather than relaxing the contract keeps the difference
# between "imports the interface" and "imports the internals" a thing CI can still tell apart.
ignore_imports =
# ADR-0040. Contexts are ordered and every edge runs down the order, through `public` only:
#
#     identity  ->  signal  ->  work  ->  commitment  ->  intelligence
#
# Identity depends on nothing. Intelligence has four edges because executing an approved Proposal is
# precisely the act of reaching across contexts, so the reaching is concentrated in one reviewable
# place rather than spread wherever somebody found it convenient.
    app.contexts.work.* -> app.contexts.identity.public
    app.contexts.signal.* -> app.contexts.identity.public
    app.contexts.commitment.* -> app.contexts.identity.public
    app.contexts.commitment.* -> app.contexts.signal.public
    app.contexts.commitment.* -> app.contexts.work.public
    app.contexts.intelligence.* -> app.contexts.identity.public
    app.contexts.intelligence.* -> app.contexts.signal.public
    app.contexts.intelligence.* -> app.contexts.work.public
    app.contexts.intelligence.* -> app.contexts.commitment.public

[importlinter:contract:api-purity]
name = Routers never touch the database or the policy engine directly
type = forbidden
source_modules =
    app.api
forbidden_modules =
    app.platform.db
    app.platform.authz.matrix
    sqlalchemy
# Contract §12 forbids a router from executing SQL or implementing authorization policy. It does not
# forbid one from calling something that eventually does — which is every service and every query
# there will ever be. Without this flag the contract fails on chains like
# `api.v1.work -> contexts.work.public -> contexts.work.models -> sqlalchemy`, where the router names
# none of it and the reported "violation" is that a returned object is an ORM row.
#
# The direct-import rule is the one worth enforcing, and it still is:
# `test_routers_are_thin` walks the AST of every module under `app/api` and fails on a direct import
# of the data layer, the policy tables, or any context internal. That test is the real contract;
# this one guards the same boundary at the package level.
allow_indirect_imports = True

[importlinter:contract:domain-has-no-web]
name = Contexts never import the web framework
type = forbidden
source_modules =
    app.contexts
forbidden_modules =
    fastapi
